# ---------------------------------------------------------------------------
# Database
# Use DATABASE_URL OR the individual DB_* variables.
# ---------------------------------------------------------------------------
DATABASE_URL=

# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=5432
# DB_NAME=

# ---------------------------------------------------------------------------
# Chamber directory ingestion
# chamber_directory_ingest.js
# ---------------------------------------------------------------------------

# OFF by default. Enable only after reviewing a dry-run execution.
CHAMBER_RUN_INGEST_FIRST=0

# Public Chamber sources supported by the first version.
CHAMBER_INGEST_SOURCES=allen,mckinney,frisco,coppell

# Safe default: log what would be inserted/updated without changing rows.
CHAMBER_INGEST_DRY_RUN=1

# Only add new Chamber records when a public business email was found.
CHAMBER_INGEST_REQUIRE_EMAIL=1

# If a Chamber listing has no direct email, inspect the company's public
# website/contact pages for a published email address.
CHAMBER_INGEST_ENRICH_WEBSITE_EMAILS=1
CHAMBER_INGEST_WEBSITE_EMAIL_MAX_PAGES=3

# Gradual rollout. 0 means unlimited.
CHAMBER_INGEST_MAX_INSERTS_PER_SOURCE=50

# Test/debug cap for how many discovered profiles to inspect per source.
# 0 = unlimited. Useful for avoiding a long dry-run when a source yields no email.
CHAMBER_INGEST_MAX_ITEMS_PER_SOURCE=0

CHAMBER_INGEST_MAX_DIRECTORY_PAGES=100

CHAMBER_INGEST_REQUEST_DELAY_MS=400
CHAMBER_INGEST_REQUEST_TIMEOUT_MS=20000
CHAMBER_INGEST_USER_AGENT=ClubhouseLinks-ChamberDirectoryIngest/1.0

# ---------------------------------------------------------------------------
# Chamber classification
# chamber_classify.js
# ---------------------------------------------------------------------------
PERPLEXITY_API_KEY=
PPLX_API_URL=https://api.perplexity.ai/chat/completions
PPLX_MODEL=sonar
CHAMBER_CLASSIFY_BATCH_SIZE=20

# The daily runner classifies new Chamber rows before running the digest.
# Set to 0 if this Railway service should run the digest only.
CHAMBER_RUN_CLASSIFY_FIRST=1

# ---------------------------------------------------------------------------
# Chamber lead digest
# chamber_lead_digest.js
# ---------------------------------------------------------------------------
CHAMBER_DIGEST_ENABLED=0

# Optional comma-separated chamber_of_commerce IDs for a limited rollout.
# Empty means all otherwise-eligible Chamber recipients.
CHAMBER_DIGEST_ALLOWED_IDS=

CHAMBER_DIGEST_COOLDOWN_HOURS=24
CHAMBER_LEAD_MAX_AGE_DAYS=30
CHAMBER_DIGEST_REQUEST_TIMEOUT_MS=45000

# Base URL used by chamber_lead_digest.js.
# The script appends /send-chamber-lead-digest.
CLUBHOUSE_API_BASE_URL=

# Must match the secret expected by the Clubhouse Links backend.
CHAMBER_ALERT_SECRET=
